fprintf('\n');
fprintf('╔════════════════════════════════════════════════╗\n');
fprintf('║          RÉSULTATS DE L''ANALYSE                ║\n');
fprintf('╚════════════════════════════════════════════════╝\n\n');

fprintf('===== PETITE MOLETTE =====\n');
fprintf('Pics détectés aux angles (°): ');
fprintf('%.1f ', angle_p(stats_p.idx_pics));
fprintf('\nPics attendus (°): ');
fprintf('%.0f ', stats_p.sequence_target);
fprintf('\nErreur max: %.2f°\n\n', stats_p.erreur_max);

fprintf('===== GRANDE MOLETTE =====\n');
fprintf('Pics détectés aux angles (°): ');
fprintf('%.1f ', angle_g(stats_g.idx_pics));
fprintf('\nPics attendus (°): ');
fprintf('%.0f ', stats_g.sequence_target);
fprintf('\nErreur max: %.2f°\n', stats_g.erreur_max);

%% ===============================================================
%  FONCTIONS UTILITAIRES
%  ===============================================================
function [positions, angle_final] = load_qtm_data_with_rotation(file_path)
    % Charge les données QTM : position 3D ET matrice de rotation
    
    fid = fopen(file_path, 'r');
    if fid == -1
        error('Fichier introuvable : %s', file_path);
    end
    
    positions = [];
    rotation_matrices = [];
    
    % Regex ultra-robustes : on cherche juste "x=..." et "matrix=(...)"
    pat_pos = 'x=([-+]?[\d.]+)[,\s]+y=([-+]?[\d.]+)[,\s]+z=([-+]?[\d.]+)';
    pat_rot = 'matrix=\(([-+]?[\d.]+)[,\s]+([-+]?[\d.]+)[,\s]+([-+]?[\d.]+)[,\s]+([-+]?[\d.]+)[,\s]+([-+]?[\d.]+)[,\s]+([-+]?[\d.]+)[,\s]+([-+]?[\d.]+)[,\s]+([-+]?[\d.]+)[,\s]+([-+]?[\d.]+)\)';
    
    while ~feof(fid)
        ligne = fgetl(fid);
        
        if ischar(ligne)
            tok_pos = regexp(ligne, pat_pos, 'tokens');
            tok_rot = regexp(ligne, pat_rot, 'tokens');
            
            % SÉCURITÉ 1 : On garde la frame QUE si on a lu les DEUX
            if ~isempty(tok_pos) && ~isempty(tok_rot)
                xyz = cellfun(@str2double, tok_pos{1});
                rot_values = cellfun(@str2double, tok_rot{1});
                R = reshape(rot_values, 3, 3)';  % Transpose car stockée ligne par ligne
                
                positions(end+1, :) = xyz;
                rotation_matrices(end+1,:,:) = R;
            end
        end
    end
    
    fclose(fid);
    
    % SÉCURITÉ 2 : Vérifie que le fichier n'était pas vide
    if isempty(positions)
        error('ERREUR LECTURE : Aucune donnée trouvée. Vérifie le format du fichier %s', file_path);
    end
    
    %% Convertir matrices de rotation → angles d'Euler
    n_frames = size(rotation_matrices, 1);
    angle_roll  = zeros(n_frames, 1);
    angle_pitch = zeros(n_frames, 1);
    angle_yaw   = zeros(n_frames, 1);
    
    for i = 1:n_frames
        R = squeeze(rotation_matrices(i, :, :));
        
        % Extraction des 3 axes possibles (convention ZYX)
        angle_roll(i)  = atan2(R(3,2), R(3,3));                     % Rotation X
        angle_pitch(i) = asin(max(-1, min(1, -R(3,1))));            % Rotation Y
        angle_yaw(i)   = atan2(R(2,1), R(1,1));                     % Rotation Z
    end
    
    % "Déplier" les angles pour éviter les cassures de 360° (Gimbal Lock)
    angle_roll  = rad2deg(unwrap(angle_roll));
    angle_pitch = rad2deg(unwrap(angle_pitch));
    angle_yaw   = rad2deg(unwrap(angle_yaw));

    % --- DÉTECTION AUTOMATIQUE DU BON AXE ---
    % Calcul de l'amplitude (max - min) manuel pour éviter les soucis de Toolbox
    amp_roll  = max(angle_roll) - min(angle_roll);
    amp_pitch = max(angle_pitch) - min(angle_pitch);
    amp_yaw   = max(angle_yaw) - min(angle_yaw);
    
    % Sélection automatique de l'axe qui a tourné le plus
    amplitudes = [amp_roll, amp_pitch, amp_yaw];
    [max_amp, axe_dominant] = max(amplitudes);
    
    if axe_dominant == 1
        angle_final = angle_roll;
        fprintf('  -> Axe détecté : ROLL (X) avec une amplitude de %.1f°\n', max_amp);
    elseif axe_dominant == 2
        angle_final = angle_pitch;
        fprintf('  -> Axe détecté : PITCH (Y) avec une amplitude de %.1f°\n', max_amp);
    else
        angle_final = angle_yaw;
        fprintf('  -> Axe détecté : YAW (Z) avec une amplitude de %.1f°\n', max_amp);
    end
end

function [stats] = analyser_sequence(angle, distance, sequence_target, nom_molette)
    % Analyse la séquence : détecte pics et zéros
    
    % Détection robuste des pics
    [~, idx_max] = findpeaks(angle, 'MinPeakDistance', 20, 'MinPeakHeight', 5);
    [~, idx_min] = findpeaks(-angle, 'MinPeakDistance', 20, 'MinPeakHeight', 5);
    
    % Fusionner et trier
    idx_pics = sort([idx_max; idx_min]);
    
    % Limiter au nombre de pics attendus
    if length(idx_pics) > length(sequence_target)
        [~, idx_sort] = sort(abs(angle(idx_pics)), 'descend');
        idx_pics = sort(idx_pics(idx_sort(1:length(sequence_target))));
    end
    
    % Calcul erreur
    angle_pics_detectes = angle(idx_pics);
    erreur = abs(angle_pics_detectes - sequence_target(:)');
    erreur_max = max(erreur);
    
    % DÉTECTION DES FRONTIÈRES DE CYCLES (NOUVEAU)
    % On cherche le passage par 0 entre chaque paire de pics (1 cycle = 2 pics)
    idx_cycle_bounds = 1; % Le premier cycle commence au début (1)
    for i = 2:2:length(idx_pics)-1
        range_search = idx_pics(i):idx_pics(i+1);
        [~, min_idx] = min(abs(angle(range_search)));
        idx_cycle_bounds(end+1) = range_search(min_idx);
    end
    idx_cycle_bounds(end+1) = length(angle); % Le dernier cycle s'arrête à la fin
    
    % On garde le premier passage par zéro comme fin du "Cycle Détaillé" (Ligne 2)
    if length(idx_cycle_bounds) >= 2
        idx_cycle_end = idx_cycle_bounds(2);
    else
        idx_cycle_end = length(angle);
    end
    
    % Enregistrement dans la structure stats
    stats.idx_pics = idx_pics;
    stats.idx_cycle_end = idx_cycle_end;
    stats.idx_cycle_bounds = idx_cycle_bounds; % <-- Ajout des frontières
    stats.erreur_max = erreur_max;
    stats.angle_pics_detectes = angle_pics_detectes;
    stats.sequence_target = sequence_target;
end