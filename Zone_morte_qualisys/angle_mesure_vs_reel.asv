%% ---- LIGNE 3 (G5 & G6) : Hystérésis DATASET COMPLET ------
for g = 1:2
    ax = subplot(2,2,g+2);
    hold(ax,'on'); grid(ax,'on'); set(ax,'Color','w');
    
    if g == 1
        angle  = angle_p;  dist = dist_p;  stats = stats_p;
        nom    = 'Petite molette';
        % --- COULEURS DU DÉGRADÉ PETITE MOLETTE ---
        color_start = [0.60 0.85 1.00]; % Bleu très clair (Début)
        color_end   = [0.00 0.15 0.60]; % Bleu très sombre (Fin)
    else
        angle  = angle_g;  dist = dist_g;  stats = stats_g;
        nom    = 'Grande molette';
        % --- COULEURS DU DÉGRADÉ GRANDE MOLETTE ---
        color_start = [1.00 0.80 0.20]; % Jaune/Orange (Début)
        color_end   = [0.60 0.00 0.00]; % Rouge très sombre (Fin)
    end
    
    bounds = stats.idx_cycle_bounds;
    num_cycles = length(bounds) - 1;
    
    % Création mathématique du gradient de couleurs
    r_grad = linspace(color_start(1), color_end(1), num_cycles);
    g_grad = linspace(color_start(2), color_end(2), num_cycles);
    b_grad = linspace(color_start(3), color_end(3), num_cycles);
    
    % Tracer chaque cycle avec sa couleur calculée dans le dégradé
    for c = 1:num_cycles
        idx_seg = bounds(c):bounds(c+1);
        col = [r_grad(c), g_grad(c), b_grad(c)];
        
        nom_cycle = sprintf('Cycle %d', c);
        
        plot(ax, angle(idx_seg), dist(idx_seg), '-', 'Color', col, 'LineWidth', 2);
    end
    
    % Marqueurs Départ/Fin
    plot(ax, 0, dist(1), 'o', 'Color', 'k', 'MarkerFaceColor', [0.1 0.8 0.2], ...
        'MarkerSize', 10, 'DisplayName', 'Début', 'LineWidth', 1.5);
    plot(ax, angle(end), dist(end), 's', 'Color', 'k', 'MarkerFaceColor', [0.9 0.2 0.2], ...
        'MarkerSize', 10, 'DisplayName', 'Fin', 'LineWidth', 1.5);
    
    % Lignes d'axes cachées de la légende
    xline(ax, 0, 'k-', 'LineWidth', 1.2, 'HandleVisibility', 'off');
    yline(ax, 0, 'k:', 'LineWidth', 1.0, 'HandleVisibility', 'off');
    
    legend(ax, 'FontSize', 9, 'Location', 'northeast', 'Box', 'on');
    xlabel(ax, 'Angle molette (°)', 'FontSize', 11, 'FontWeight', 'bold');
    ylabel(ax, 'Distance TIP (mm)', 'FontSize', 11, 'FontWeight', 'bold');
    title(ax, [nom ' — Séquence en dégradé'], 'FontSize', 12, 'FontWeight', 'bold');
    set(ax, 'FontSize', 10);
end

sgtitle('Analyse d''Hystérésis — Angles d''Euler extraits de la Matrice de Rotation QTM', ...
    'FontSize', 14, 'FontWeight', 'bold');

%% ===============================================================
%  AFFICHAGE DES STATISTIQUES
