%% ============================================================
%  ANALYSE HYSTÉRÉSIS — AVEC ANGLES D'EULER DE MATRICE ROTATION
%  Léon - 2026 — VERSION MATRICE ROTATION → EULER
%
%  Extrait la matrice de rotation 3x3 du fichier QTM
%  Convertit en angles d'Euler (yaw = rotation molette)
%  X (hystérésis) = Angle YAW (°)
%  Y (hystérésis) = Distance du TIP (mm)
% ============================================================
clear; clc; close all;

%% ---------------------------------------------------------------
%  PARAMÈTRES ET SÉQUENCES
%  ---------------------------------------------------------------
fichier_petite = 'C:\Users\LEROY\Documents\Python_qualisys\Zone_morte_qualisys\poses_qtm_20260527_154128_petite_vraidecre.txt';
fichier_grande = 'C:\Users\LEROY\Documents\Python_qualisys\Zone_morte_qualisys\poses_qtm_20260527_154353_grande_decrevrai.txt';

% Les séquences attendues (pour validation)
SEQ_PETITE = [50, -60, 30, -30, 10];
SEQ_GRANDE = [120, -80, 100, -50, 50];

%% ---------------------------------------------------------------
%  CHARGEMENT DES DONNÉES
%  ---------------------------------------------------------------
fprintf('Chargement petite molette...\n');
[pos_p, angle_p_raw] = load_qtm_data_with_rotation(fichier_petite);

fprintf('Chargement grande molette...\n');
[pos_g, angle_g_raw] = load_qtm_data_with_rotation(fichier_grande);

%% ---------------------------------------------------------------
%  LISSAGE ET CENTRAGE DES ANGLES
%  ---------------------------------------------------------------
% Lissage pour réduire le bruit
angle_p = movmean(angle_p_raw, 15);
angle_g = movmean(angle_g_raw, 15);

% Soustraire la valeur initiale (mettre à ~0 au départ)
angle_p = angle_p - angle_p(1);
angle_g = angle_g - angle_g(1);

% Calcul des distances du TIP
dist_p = sqrt(sum((pos_p - pos_p(1,:)).^2, 2));
dist_g = sqrt(sum((pos_g - pos_g(1,:)).^2, 2));

%% ---------------------------------------------------------------
%  ANALYSE : DÉTECTER LES PICS ET ZÉROS
%  ---------------------------------------------------------------
fprintf('\nAnalyse Petite Molette...\n');
[stats_p] = analyser_sequence(angle_p, dist_p, SEQ_PETITE, 'Petite');

fprintf('Analyse Grande Molette...\n');
[stats_g] = analyser_sequence(angle_g, dist_g, SEQ_GRANDE, 'Grande');

%% ---------------------------------------------------------------
%  FIGURE — 6 graphiques d'hystérésis
%  ---------------------------------------------------------------
fig = figure('Name','Analyse Hystérésis Molettes - Angles EULER (YAW)', ...
    'Color','w', 'Position',[50 50 1400 950]); 

%% ---- LIGNE 1 (G1 & G2) : Angle et Distance vs temps ------
for g = 1:2
    ax1 = subplot(2,2,g);
    hold(ax1,'on'); grid(ax1,'on'); set(ax1,'Color','w');
    
    if g == 1
        angle  = angle_p;
        dist   = dist_p;
        couleur = [0.20 0.53 0.96];
        nom    = 'Petite molette';
    else
        angle  = angle_g;
        dist   = dist_g;
        couleur = [0.85 0.25 0.15];
        nom    = 'Grande molette';
    end
    
    n = length(angle);
    t = 1:n;
    
    yyaxis left
    plot(ax1, t, angle, 'Color', couleur, 'LineWidth', 2);
    ylabel(ax1, 'Angle YAW (°)', 'FontSize', 10, 'Color', couleur);
    set(ax1, 'YColor', couleur);
    
    yyaxis right
    plot(ax1, t, dist, '--', 'Color', [0.2 0.8 0.2], 'LineWidth', 1.5);
    ylabel(ax1, 'Distance TIP (mm)', 'FontSize', 10, 'Color', [0.2 0.8 0.2]);
    set(ax1, 'YColor', [0.2 0.8 0.2]);
    
    xlabel(ax1, 'Frame', 'FontSize', 10);
    title(ax1, [nom ' — Angle (°) et Distance TIP (mm)'], 'FontSize', 11, 'FontWeight', 'bold');
    set(ax1, 'FontSize', 10);
end

% %% ---- LIGNE 2 (G3 & G4) : Hystérésis 1er Cycle DÉTAILLÉ ------
